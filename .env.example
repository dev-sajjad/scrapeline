# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
SCRAPELINE_ENV=dev
DATABASE_URL=postgresql+psycopg://scrapeline:scrapeline@localhost:5432/scrapeline
RAW_STORE_DIR=data/raw
# Crawler identity. Public contact only; never a private account email.
CRAWLER_USER_AGENT=scrapeline/0.1 (+https://github.com/dev-sajjad/scrapeline; sajjadbmarpc@gmail.com)
# Fixture sites (served by nginx in docker compose)
FIXTURE_BASE_URL=http://localhost:8080
# Models. Change only via ADR or eval result.
MODEL_GENERATE=claude-opus-5-5
MODEL_REPAIR=claude-opus-5-5
MODEL_CHEAP=claude-haiku-5-5
AGENT_MAX_USD_PER_RUN=2.0
